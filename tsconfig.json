{
  "$schema": "https://raw.githubusercontent.com/Effect-TS/language-service/refs/heads/main/schema.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "types": ["bun"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "overrides": [
          {
            "include": ["src/platform/**/*.ts", "src/daemon/**/*.ts", "src/main.ts"],
            "options": {
              "allowedUnstableApis": [
                "effect/process",
                "effect/Stdio",
                "effect/cli",
                "effect/FileSystem",
                "effect/Path",
                "@effect/platform-bun"
              ]
            }
          },
          {
            "include": ["src/**/*.test.ts"],
            "options": {
              "allowedUnstableApis": [
                "@effect/vitest",
                "effect/process",
                "effect/Stdio",
                "effect/cli",
                "effect/FileSystem",
                "effect/Path",
                "@effect/platform-bun"
              ]
            }
          }
        ]
      }
    ]
  },
  "include": ["src/**/*.ts", "oxlint.config.ts", "vitest.config.ts"]
}
